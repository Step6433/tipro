{
  "name": "tipro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "dev:api": "cd backend && .venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 --no-access-log",
    "test:backend": "cd backend && .venv/bin/python -m pytest -q",
    "check:api": "node scripts/check-api.mjs",
    "start": "backend/.venv/bin/python scripts/start.py",
    "db:schema": "backend/.venv/bin/python backend/scripts/export_schema.py"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "pinia": "^3.0.0",
    "lucide-vue-next": "^0.468.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0"
  }
}
